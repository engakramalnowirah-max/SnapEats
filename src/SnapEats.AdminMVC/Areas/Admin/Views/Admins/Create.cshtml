@model CreateAdminViewModel
@{
    ViewData["Title"] = "إضافة مسؤول جديد";
}

<div class="page-header-bar">
    <div class="header-title">
        <h1><i class="fas fa-user-plus"></i> إضافة حساب مسؤول جديد (Admin)</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">لوحة التحكم</a></li>
                <li class="breadcrumb-item"><a href="/Admin/Admins">المسؤولين</a></li>
                <li class="breadcrumb-item active">إضافة مسؤول</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="fas fa-id-card text-primary me-2"></i>بيانات حساب المسؤول</h5>
            </div>
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="Admins" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <input asp-for="FullName" class="form-control form-control-lg" placeholder="أدخل الاسم الكامل للمسؤول..." />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="admin@snapeats.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="******" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="******" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                        <a href="/Admin/Admins" class="k-button k-button-md k-rounded-md k-outline">
                            <i class="fas fa-arrow-right me-1"></i> إلغاء ورجوع
                        </a>
                        <button type="submit" class="k-button k-button-md k-rounded-md k-primary">
                            <i class="fas fa-save me-1"></i> حفظ وتأكيد الحساب
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
