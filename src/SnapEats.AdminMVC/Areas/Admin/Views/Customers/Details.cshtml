@model CustomerViewModel
@{
    ViewData["Title"] = $"العملاء - {Model.FullName}";
    var orders = ViewBag.CustomerOrders as List<OrderViewModel> ?? new();
}

<div class="page-header-bar">
    <div class="header-title">
        <h1><i class="fas fa-user-circle"></i> الملف الشخصي للعميل</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">لوحة التحكم</a></li>
                <li class="breadcrumb-item"><a href="/Admin/Customers">العملاء</a></li>
                <li class="breadcrumb-item active">@Model.FullName</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center mx-auto mb-3 shadow"
                     style="width: 90px; height: 90px; font-size: 2.2rem; font-weight: 800; background: linear-gradient(135deg, var(--primary) 0%, #FF2E43 100%);">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1))
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small">مسجل منذ @Model.CreatedAtFormatted</p>
                <div class="mt-3">
                    <a href="/Admin/Customers/Edit/@Model.Id" class="k-button k-button-md k-rounded-md k-warning w-100 mb-2">
                        <i class="fas fa-edit me-1"></i> تعديل بيانات العميل
                    </a>
                </div>
            </div>
            <ul class="list-group list-group-flush border-top">
                <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="fas fa-envelope text-primary me-2"></i> البريد الإلكتروني</span>
                        <span class="fw-bold">@Model.Email</span>
                    </div>
                </li>
                <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="fas fa-phone text-primary me-2"></i> رقم الجوال</span>
                        <span dir="ltr" class="fw-bold">@Model.Phone</span>
                    </div>
                </li>
                <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="fas fa-calendar-alt text-primary me-2"></i> تاريخ التسجيل</span>
                        <span class="fw-bold">@Model.CreatedAtFormatted</span>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                <span><i class="fas fa-shopping-bag"></i> سجل طلبات العميل (@orders.Count)</span>
            </div>
            <div class="card-body">
                @if (orders.Any())
                {
                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>رقم الطلب</th>
                                    <th>تاريخ الطلب</th>
                                    <th>المجموع</th>
                                    <th>حالة الطلب</th>
                                    <th>التفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders)
                                {
                                    <tr>
                                        <td><strong>#@order.Id</strong></td>
                                        <td>@order.OrderDateFormatted</td>
                                        <td><strong class="text-primary">@order.TotalFormatted</strong> ريال</td>
                                        <td>
                                            <span class="k-chip k-chip-solid-@(order.Status == "Pending" ? "warning" : order.Status == "Confirmed" ? "info" : order.Status == "Preparing" ? "primary" : order.Status == "OutForDelivery" ? "secondary" : order.Status == "Delivered" ? "success" : "danger")">@order.StatusText</span>
                                        </td>
                                        <td>
                                            <a href="/Admin/Orders/Details/@order.Id" class="k-button k-button-md k-rounded-md k-info">
                                                <i class="fas fa-eye me-1"></i> عرض
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-shopping-bag"></i>
                        <h5>لا توجد طلبات سابقة</h5>
                        <p>لم يقم هذا العميل بإجراء أي طلبات طعام بعد.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>