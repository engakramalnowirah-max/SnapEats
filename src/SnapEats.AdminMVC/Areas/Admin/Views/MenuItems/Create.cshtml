@model CreateMenuItemViewModel
@{
    ViewData["Title"] = "إضافة وجبة جديدة";
    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new();
}

<div class="page-header-bar">
    <div class="header-title">
        <h1><i class="fas fa-plus-circle"></i> إضافة وجبة طعام جديدة</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">لوحة التحكم</a></li>
                <li class="breadcrumb-item"><a href="/Admin/MenuItems">قائمة الطعام</a></li>
                <li class="breadcrumb-item active">إضافة وجبة</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span><i class="fas fa-utensils"></i> بيانات الوجبة</span>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="MenuItems" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- اختر تصنيف الوجبة --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الوجبة..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="أدخل مكونات أو وصف الوجبة..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row align-items-center">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" placeholder="0.00" type="number" step="0.01" />
                            <span class="input-group-text bg-light text-dark font-weight-bold">ريال</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label asp-for="ImageUrl" class="form-label"></label>
                        <input asp-for="ImageUrl" class="form-control" data-preview="imagePreview"
                               placeholder="https://example.com/image.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">حالة الوجبة</label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsAvailable" class="form-check-input" role="switch" id="isAvailableSwitch" />
                            <label class="form-check-label font-weight-bold ms-2" for="isAvailableSwitch">متاحة للطلب</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">معاينة صورة الوجبة</label>
                <div class="p-3 border rounded bg-light d-inline-block">
                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        <img id="imagePreview" src="@Model.ImageUrl" class="product-image" style="width:100px;height:100px;object-fit:cover;" alt="Preview" />
                    }
                    else
                    {
                        <img id="imagePreview" class="product-image" style="width:100px;height:100px;object-fit:cover;display:none;" alt="Preview" />
                        <div id="noPreviewPlaceholder" class="product-image-placeholder" style="width:100px;height:100px;font-size:1.8rem;">
                            <i class="fas fa-image"></i>
                        </div>
                    }
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-3">
                <button type="submit" class="k-button k-button-md k-rounded-md k-primary">
                    <i class="fas fa-check-circle me-1"></i> حفظ الوجبة
                </button>
                <a href="/Admin/MenuItems" class="k-button k-button-md k-rounded-md k-outline">
                    <i class="fas fa-arrow-right me-1"></i> إلغاء ورجوع
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('input[name="ImageUrl"]').on('input change', function () {
                var url = $(this).val();
                if (url && url.length > 5) {
                    $('#imagePreview').attr('src', url).show();
                    $('#noPreviewPlaceholder').hide();
                } else {
                    $('#imagePreview').hide();
                    $('#noPreviewPlaceholder').show();
                }
            });
        });
    </script>
}