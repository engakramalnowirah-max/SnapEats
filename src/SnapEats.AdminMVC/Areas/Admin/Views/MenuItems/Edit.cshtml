@model EditMenuItemViewModel
@{
    ViewData["Title"] = "تعديل الوجبة";
    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new();
}

<div class="page-header-bar">
    <div class="header-title">
        <h1><i class="fas fa-edit"></i> تعديل بيانات الوجبة</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">لوحة التحكم</a></li>
                <li class="breadcrumb-item"><a href="/Admin/MenuItems">قائمة الطعام</a></li>
                <li class="breadcrumb-item active">تعديل #@Model.Id</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span><i class="fas fa-utensils"></i> تعديل الوجبة رقم #@Model.Id</span>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="MenuItems" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الوجبة..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text bg-light text-dark font-weight-bold">ريال</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">حالة التوفر</label>
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsAvailable" class="form-check-input" role="switch" id="editIsAvailableSwitch" />
                            <label class="form-check-label font-weight-bold ms-2" for="editIsAvailableSwitch">متاح للطلب</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="أدخل وصف الوجبة..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" data-preview="editImagePreview" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">معاينة الصورة الحالية</label>
                <div class="p-3 border rounded bg-light d-inline-block">
                    <img id="editImagePreview" src="@Model.ImageUrl" class="product-image" style="width:100px;height:100px;object-fit:cover; @(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")" alt="Preview" />
                    <div id="noPreviewPlaceholder" class="product-image-placeholder" style="width:100px;height:100px;font-size:1.8rem; @(!string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")">
                        <i class="fas fa-image"></i>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-3">
                <button type="submit" class="k-button k-button-md k-rounded-md k-primary">
                    <i class="fas fa-save me-1"></i> حفظ التغييرات
                </button>
                <a href="/Admin/MenuItems" class="k-button k-button-md k-rounded-md k-outline">
                    <i class="fas fa-arrow-right me-1"></i> إلغاء ورجوع
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('input[name="ImageUrl"]').on('input change', function () {
                var url = $(this).val();
                if (url && url.length > 5) {
                    $('#editImagePreview').attr('src', url).show();
                    $('#noPreviewPlaceholder').hide();
                } else {
                    $('#editImagePreview').hide();
                    $('#noPreviewPlaceholder').show();
                }
            });
        });
    </script>
}