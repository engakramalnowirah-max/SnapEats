@model OrderViewModel
@{
    ViewData["Title"] = "تعديل الطلب";
    var customers = ViewBag.Customers as List<CustomerViewModel> ?? new();
}

<div class="page-header-bar">
    <div class="header-title">
        <h1><i class="fas fa-edit"></i> تعديل بيانات الطلب</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard">لوحة التحكم</a></li>
                <li class="breadcrumb-item"><a href="/Admin/Orders">الطلبات</a></li>
                <li class="breadcrumb-item active">تعديل #@Model.Id</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span><i class="fas fa-receipt"></i> تعديل الطلب رقم #@Model.Id</span>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Orders" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">العميل صاحب الطلب</label>
                        <select asp-for="CustomerId" class="form-select">
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id" selected="@(customer.Id == Model.CustomerId)">@customer.FullName (@customer.Email)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">حالة الطلب الحالية</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending")">قيد الانتظار</option>
                            <option value="Confirmed" selected="@(Model.Status == "Confirmed")">مؤكد</option>
                            <option value="Preparing" selected="@(Model.Status == "Preparing")">قيد التحضير</option>
                            <option value="OutForDelivery" selected="@(Model.Status == "OutForDelivery")">قيد التوصيل</option>
                            <option value="Delivered" selected="@(Model.Status == "Delivered")">تم التوصيل</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">ملغي</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">المبلغ الإجمالي المعدل</label>
                        <div class="input-group">
                            <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text bg-light text-dark font-weight-bold">ريال</span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-3">
                <button type="submit" class="k-button k-button-md k-rounded-md k-primary">
                    <i class="fas fa-save me-1"></i> حفظ التغييرات
                </button>
                <a href="/Admin/Orders" class="k-button k-button-md k-rounded-md k-outline">
                    <i class="fas fa-arrow-right me-1"></i> إلغاء ورجوع
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
