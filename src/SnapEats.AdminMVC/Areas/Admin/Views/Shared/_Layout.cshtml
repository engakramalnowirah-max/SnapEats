@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var rawApiUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5065/api/v1/";
    var apiOrigin = rawApiUrl.Replace("/api/v1/", "").Replace("/api/v1", "").TrimEnd('/');
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سناب إيتس | لوحة التحكم</title>

    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.2.514/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.2.514/styles/kendo.default-v2.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.2.514/styles/kendo.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/snapeats.css" asp-append-version="true" />
</head>


<body>
    <div class="app-wrapper">
        <div class="sidebar-overlay"></div>
        <aside id="sidebar" class="app-sidebar">
            <div class="sidebar-brand">
                <a href="/Admin/Dashboard" class="brand-link">
                    <span class="brand-icon"><i class="fas fa-utensils"></i></span>
                    <span class="brand-text">سناب إيتس</span>
                </a>
            </div>

            <div class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           href="/Admin/Dashboard" title="لوحة التحكم">
                            <i class="fas fa-chart-pie"></i>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")"
                           href="/Admin/Categories" title="التصنيفات">
                            <i class="fas fa-tags"></i>
                            <span>التصنيفات</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MenuItems" ? "active" : "")"
                           href="/Admin/MenuItems" title="قائمة الطعام">
                            <i class="fas fa-hamburger"></i>
                            <span>قائمة الطعام</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "active" : "")"
                           href="/Admin/Orders" title="الطلبات">
                            <i class="fas fa-shopping-cart"></i>
                            <span>الطلبات</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")"
                           href="/Admin/Customers" title="العملاء">
                            <i class="fas fa-users"></i>
                            <span>العملاء</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admins" ? "active" : "")"
                           href="/Admin/Admins" title="المسؤولين">
                            <i class="fas fa-user-shield"></i>
                            <span>المسؤولين</span>
                        </a>
                    </li>
                    <li class="nav-item sidebar-divider-item">
                        <hr class="sidebar-divider">
                    </li>
                    <li class="nav-item">
                        <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                            @Html.AntiForgeryToken()
                            <a class="nav-link text-danger" href="javascript:void(0)"
                               onclick="document.getElementById('logoutForm').submit()" title="تسجيل الخروج">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>تسجيل الخروج</span>
                            </a>
                        </form>
                    </li>

                </ul>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" id="sidebarToggle" class="topbar-toggle">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>

                <div class="topbar-right">
                    <div class="topbar-dropdown dropdown">
                        <a class="topbar-user dropdown-toggle" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar"><i class="fas fa-user-circle"></i></span>
                            <span class="user-name d-none d-sm-inline">@(Context.Request.Cookies["UserName"] ?? "مدير النظام")</span>
                            <i class="fas fa-chevron-down dropdown-arrow d-none d-sm-inline"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/Admin/Dashboard"><i class="fas fa-chart-pie me-2"></i>لوحة التحكم</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                        <i class="fas fa-sign-out-alt me-2"></i>تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                <div class="content-header">
                    @RenderSection("PageHeader", required: false)
                </div>

                @if (TempData["Success"] != null)
                {
                    <div id="successNotification" data-message="@TempData["Success"]"></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div id="errorNotification" data-message="@TempData["Error"]"></div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="footer-content">
                    <span class="footer-copy">© @DateTime.Now.Year - منصة سناب إيتس لإدارة الطلبات. جميع الحقوق محفوظة</span>
                    <span class="footer-version"><i class="fas fa-shield-alt text-primary me-1"></i> نسخة 1.0.0</span>
                </div>
            </footer>
        </div>
    </div>

    <div id="confirmWindow"></div>
    <div id="notificationWidget" style="display:none;"></div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2024.2.514/js/kendo.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/snapeats.js" asp-append-version="true"></script>
    <script>
        window.SNAP_EATS_API_URL = "@apiOrigin";
    </script>
    <script src="~/js/admin-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>


</html>